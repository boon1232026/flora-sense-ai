{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pump command",
  "type": "object",
  "required": ["schema_version", "command_id", "device_id", "plant_id", "issued_at", "expires_at", "mode", "action", "duration_seconds", "non_retained"],
  "properties": {
    "schema_version": {"const": 1},
    "command_id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
    "device_id": {"type": "string"},
    "plant_id": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["MANUAL", "AUTO"]},
    "action": {"enum": ["start", "stop"]},
    "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
    "non_retained": {"const": true},
    "requester": {"type": "string"}
  },
  "additionalProperties": false
}
