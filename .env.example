# Local development only. Copy to .env and fill values outside version control.
FLORA_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flora_sense
POSTGRES_USER=flora
POSTGRES_PASSWORD=change-me-locally
# Wokwi development simulation uses the public broker below. Use a private
# authenticated broker outside development and keep credentials in .env only.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_CA_FILE=
MQTT_TOPIC_PREFIX=flora-sense-ai/a007
BACKEND_PORT=18080
AI_SERVICE_URL=http://localhost:18001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FLORA_API_TOKEN=change-me-app-token
FLORA_DEVICE_TOKEN=change-me-device-token
FLORA_STATE_FILE=./data/flora-state.tsv
FLORA_UPLOAD_DIR=./data/uploads
FLORA_DEVICE_IDS=FLORA-ESP32-WOKWI
BACKEND_URL=http://127.0.0.1:18080
COMMAND_POLL_SECONDS=2
IMAGE_POLL_SECONDS=3
TELEMETRY_AI_POLL_SECONDS=2
